{
  "name": "@dk/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:intake": "npx tsx --test scripts/intake.check.ts",
    "check:onboarding": "npx tsx --test scripts/onboarding.check.ts",
    "check:onboarding-calls": "npx tsx --test scripts/onboardingCalls.check.ts",
    "check:portal-login": "npx tsx --test scripts/portalLogin.check.ts",
    "check:payments": "npx tsx --test scripts/payments.check.ts",
    "check:billing": "npx tsx --test scripts/billing.check.ts",
    "check:autopay": "npx tsx --test scripts/autopay.check.ts",
    "check:leads": "npx tsx --test scripts/leads.check.ts",
    "check:watch-hold": "npx tsx --test scripts/watchHold.check.ts",
    "check:outlets": "npx tsx --test scripts/outlets.check.ts",
    "check:guide-videos": "npx tsx --test scripts/guideVideos.check.ts",
    "check:chat-videos": "npx tsx --test scripts/chatGuideVideos.check.ts",
    "check:chat-transcript": "npx tsx --test scripts/chatTranscript.check.ts",
    "check:nav-order": "npx tsx --test scripts/navOrder.check.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@dk/shared": "file:./shared",
    "@hookform/resolvers": "^3.9.0",
    "@rjsf/core": "^5.21.2",
    "@rjsf/utils": "^5.21.2",
    "@rjsf/validator-ajv8": "^5.21.2",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.8.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
